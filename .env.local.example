# ─────────────────────────────────────────────────
# Cyber Sahayak — Environment Variables
# Copy this file to .env.local and fill in your keys
# ─────────────────────────────────────────────────

# OPTION 1: xAI (Grok) — recommended
# Get key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# OPTION 2: OpenAI — fallback (used if XAI_API_KEY is not set)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────
# NOTE: Never commit .env.local to git!
# The .gitignore already excludes it.
# ─────────────────────────────────────────────────
